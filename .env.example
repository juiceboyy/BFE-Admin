# Environment variables for BFE Admin (Netlify Functions)
# Copy this file to .env for local development with `netlify dev`

GEMINI_API_KEY=your_gemini_api_key_here

# Peppol Access Point (Recommand.eu) - optional for direct API transmission
RECOMMAND_API_KEY=your_recommand_api_key_here
RECOMMAND_API_SECRET=your_recommand_api_secret_here
RECOMMAND_COMPANY_ID=your_recommand_company_id_here
